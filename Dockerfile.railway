FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

# Install Ollama
RUN curl -fsSL https://ollama.com/install.sh | sh

# Copy requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy Phase 4 files
COPY atlassian_ingester_full.py \
    search_phase2.py \
    synthesis_ultimate.py \
    app_phase2.py \
    entrypoint_phase2.py \
    ./

# Set environment
ENV PORT=8000
ENV PYTHONUNBUFFERED=1
ENV OLLAMA_HOST=http://localhost:11434
ENV ES_HOST=http://localhost:9200

EXPOSE 8000

# Start Ollama in background, then run app
CMD bash -c "ollama serve &" && sleep 3 && python entrypoint_phase2.py
