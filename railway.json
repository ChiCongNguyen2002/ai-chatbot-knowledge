{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "python app_v01.py",
    "healthcheckPath": "/health",
    "healthcheckInterval": 10
  },
  "env": {
    "PORT": "8000",
    "PYTHONUNBUFFERED": "1"
  }
}
